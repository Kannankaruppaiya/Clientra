# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=keep-this-server-only   # NEVER expose to the browser

# hCaptcha
NEXT_PUBLIC_HCAPTCHA_SITEKEY=your-sitekey
HCAPTCHA_SECRET=your-secret
NEXT_PUBLIC_HCAPTCHA_MODE=enabled

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=keep-this-server-only

# Web push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=keep-this-server-only

# App
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=admin@example.com
